-- HELPERS
local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = obj
    return c
end

local function stroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(70, 150, 255)
    s.Thickness = thickness or 1.5
    s.Parent = obj
    return s
end

local function makeLabel(parent, text, size, pos, textSize)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = size
    label.Position = pos
    label.Text = text
    label.TextColor3 = Color3.fromRGB(235, 243, 255)
    label.TextSize = textSize or 13
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent
    return label
end

local function makeButton(parent, text, size, pos)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos
    b.Text = text
    b.TextSize = 13
    b.Font = Enum.Font.GothamSemibold
    b.TextColor3 = Color3.fromRGB(245, 248, 255)
    b.BackgroundColor3 = Color3.fromRGB(25, 32, 52)
    b.AutoButtonColor = false
    b.BorderSizePixel = 0
    b.Parent = parent
    corner(b, 8)
    return b
end

