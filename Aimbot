-- TOGGLES
local function makeToggle(text, y, callback)
    local enabled = false

    local b = makeButton(
        page,
        "",
        UDim2.new(1, -24, 0, 36),
        UDim2.fromOffset(12, y)
    )
    b.TextXAlignment = Enum.TextXAlignment.Left

    local function update()
        b.Text = "   " .. text .. "       " ..
            (enabled and "ON" or "OFF")

        b.BackgroundColor3 = enabled
            and Color3.fromRGB(18, 70, 115)
            or Color3.fromRGB(22, 30, 49)
    end

    b.Activated:Connect(function()
        enabled = not enabled
        update()
        callback(enabled)
    end)

    update()
end

